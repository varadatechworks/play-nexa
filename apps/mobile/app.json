{
  "expo": {
    "name": "PlayNexa Arena",
    "slug": "playnexa-arena",
    "version": "1.1.1",
    "orientation": "portrait",
    "scheme": "playnexa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.varadatechworks.playnexa.demo"
    },
    "android": {
      "package": "com.varadatechworks.playnexa.demo",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 3
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "imageWidth": 140
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PlayNexa uses your location with permission to record activities. You can continue without location.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
